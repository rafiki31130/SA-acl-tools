# Visibility of the app and of its objects (spec section 7).
#
# The app is not exported: its objects stay confined to its own context. The
# `edit_acl_bulk` capability is granted outside the app, by the role management chain.
#
# The `editacl` command, on the other hand, is exported to the whole system: without
# that it would only be invocable from this app's context, which would rule out its
# use from an ad hoc search. The effective access control is still carried by the
# capability, not by this declaration.

[]
access = read : [ * ], write : [ admin ]
export = none

[commands]
export = system

[commands/editacl]
access = read : [ * ], write : [ admin ]
export = system

# `editappacl` follows the same reasoning (v4.2 section 14.1, deliverable 6): exported to
# the whole system, because a command that could only be invoked from this app's context
# would be unusable from an ad hoc search - which is where an operator governs an
# application's permissions. The effective access control stays carried by the
# `edit_app_acl_bulk` capability, not by this declaration.
#
# No class-wide `[views]` stanza is added here either: the per-object stanza below is
# enough, and a class-wide one would export every future view of this app without
# anybody deciding it.

[commands/editappacl]
access = read : [ * ], write : [ admin ]
export = system

# `appaclinventory` follows the same reasoning (v4.2 section 14.1, deliverable 6), and
# it is even harder to argue against here: the inventory is the FIRST command of the
# whole workflow - section 12.2 says to consult it before engaging either write tool -
# and a command invocable only from the context of a hidden app would be consulted by
# nobody. The effective access control stays carried by the `list_app_acl` capability.

[commands/appaclinventory]
access = read : [ * ], write : [ admin ]
export = system

# The search assistant follows the command. It reads `configs/conf-searchbnf` in the
# namespace of the PAGE, that is, the app from which the operator types the search:
# `search`, not `SA-acl-tools`. Confined to the app context, `searchbnf.conf` is
# loaded, parsed, exposed on `/servicesNS/nobody/SA-acl-tools/...` and strictly
# without effect where the operator types: no coloring of the command name, no syntax,
# no example. No error is raised anywhere. The gap is silent, and that is the reason
# this stanza exists.
#
# It necessarily goes with `[commands] export = system`: a command that can be invoked
# everywhere but whose help is visible nowhere is an inconsistency.

[searchbnf]
access = read : [ * ], write : [ admin ]
export = system

# The macros are exported to the system for the same reason as the command:
# `acl_inventory` must be invocable inline from any ad hoc search (section 6.7
# constraint 1). Confined to the app context, it would not be.
#
# The lookup definition and the lookup file it designates follow: an exported macro
# that relies on a non-exported `inputlookup` fails outside its own app.

[macros]
access = read : [ * ], write : [ admin ]
export = system

[transforms]
access = read : [ * ], write : [ admin ]
export = system

# `props.conf` carries SEARCH-TIME settings for the two sourcetypes of this app, and a
# search-time setting only applies in the namespaces it is exported to. Confined to the
# app context it would be inert everywhere the operator actually searches.
#
# MEASURED, and this is the whole reason the stanza exists: with `props` unexported, the
# same query on the diagnostic sourcetype returns 248 clean run identifiers in the
# namespace of this app, and 259 - of which 11 carry a whole sentence swallowed by the
# automatic extractor - in the namespace of `search`. The monitoring view opens from any
# app context, and every ad hoc search on the journal is typed from `search`.
#
# What is exported is narrow: two stanzas, both naming sourcetypes owned by this app.
# Nothing here can alter the reading of anybody else's data.
#
# The journal never depended on this: its JSON is picked up by the platform on its own,
# which is exactly what hid the gap until it was measured.

[props]
access = read : [ * ], write : [ admin ]
export = system

[lookups]
access = read : [ * ], write : [ admin ]
export = system

# The shipped searches stay in the app context: they are an audit starting point, not
# a dependency of other apps.
[savedsearches]
access = read : [ * ], write : [ admin ]
export = none

# Run monitoring view (specification section 15). Exported to the system so it opens
# from any app context: the app carries `is_visible = 0`, and a view that could only be
# reached from a hidden app would be unreachable in practice. MEASURED, with the
# negative control that makes the measurement conclusive: the same view declared
# `export = none` answers 404 from another app, while this one answers 200 - including
# from the context of the hidden app itself. `is_visible = 0` restricts the app
# selector and nothing else.
#
# Read is restricted to the single role the app declares (D-44). Two facts that no
# declaration here can change, both measured: an account holding `admin_all_objects`
# reads the view anyway, and an account WITHOUT the role gets a 404, not a 403.
#
# `export = system` reads back as `sharing = global` in the ACL API, never as `system`.
# An operational check written on `sharing="system"` would find nothing.
#
# No class-wide `[views]` stanza is added: the per-object stanza is enough, and a
# class-wide one would export every future view of this app without anyone deciding it.

[views/editacl_runs]
access = read : [ editacl_auditor ], write : [ admin ]
export = system
