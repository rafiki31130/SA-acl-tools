# Visibilite de l'app et de ses objets (§7).
#
# L'app n'est pas exportee : ses objets restent confines a son contexte. La capability
# `edit_acl_bulk` est attribuee hors de l'app, par la chaine de gestion des roles.
#
# La commande `editacl` est en revanche exportee a l'ensemble du systeme : sans cela
# elle ne serait invocable que depuis le contexte de cette app, ce qui interdirait son
# usage depuis une recherche ad hoc. Le controle d'acces effectif reste porte par la
# capability, pas par cette declaration.

[]
access = read : [ * ], write : [ admin ]
export = none

[commands]
export = system

[commands/editacl]
access = read : [ * ], write : [ admin ]
export = system

# L'assistant de recherche suit la commande. Il lit `configs/conf-searchbnf` dans le
# namespace de la PAGE, c'est-a-dire l'app depuis laquelle l'operateur saisit sa
# recherche — `search`, pas `SA-acl-tools`. Confine au contexte de l'app, le
# `searchbnf.conf` est charge, parse, expose sur `/servicesNS/nobody/SA-acl-tools/...`
# et rigoureusement sans effet la ou l'operateur tape : ni coloration du nom de
# commande, ni syntaxe, ni exemple. Aucune erreur n'est levee — c'est un manque
# silencieux, et c'est la raison d'etre de cette stanza.
#
# Elle accompagne necessairement `[commands] export = system` : une commande invocable
# partout dont l'aide n'est visible nulle part est une incoherence.

[searchbnf]
access = read : [ * ], write : [ admin ]
export = system

# Les macros sont exportees au systeme pour la meme raison que la commande :
# `acl_inventory` doit etre invocable en ligne depuis n'importe quelle recherche
# ad hoc (§6.7 contrainte 1). Confinee au contexte de l'app, elle ne le serait pas.
#
# La definition de lookup et le fichier de lookup qu'elle designe suivent : une macro
# exportee qui s'appuie sur un `inputlookup` non exporte echoue hors de son app.

[macros]
access = read : [ * ], write : [ admin ]
export = system

[transforms]
access = read : [ * ], write : [ admin ]
export = system

[lookups]
access = read : [ * ], write : [ admin ]
export = system

# Les recherches livrees restent dans le contexte de l'app : elles sont un point de
# depart d'audit, pas une dependance d'autres apps.
[savedsearches]
access = read : [ * ], write : [ admin ]
export = none
