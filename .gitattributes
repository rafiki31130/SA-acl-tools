* text=auto eol=lf

# Vendored dependencies: stored byte for byte, never converted. Any line-ending
# conversion would invalidate bin/lib/MANIFEST.sha256 at clone time.
bin/lib/** -text

# Scope of the deployable archive (spec section 12.1): tests/ and tools/ live in the
# repository, never in the installed app. `git archive` therefore leaves them out,
# along with the repository's own service files. See README, Tests section.
tests/         export-ignore
tools/         export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
