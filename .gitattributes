* text=auto eol=lf

# Vendored dependencies: stored byte for byte, never converted. Any line-ending
# conversion would invalidate bin/lib/MANIFEST.sha256 at clone time.
bin/lib/** -text

# Scope of the deployable archive (spec section 12.1): tests/, tools/ and DEVNOTES.md
# live in the repository, never in the installed app. `git archive` therefore leaves them
# out, along with the repository's own service files.
#
# DEVNOTES.md carries the development notes: architecture, measurements, design decisions
# and the exhaustive operator reference. It is written for whoever changes this code, not
# for whoever runs it, and the operator README is self-sufficient without it.
tests/         export-ignore
tools/         export-ignore
DEVNOTES.md    export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
